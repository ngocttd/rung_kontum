<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const fv = fcg ? fcg.forecast.validation : null; const vd = danger ? danger.validation : null; %>
<%- include('../partials/banner', { banner: 'p11-guide', heading: 'Hướng dẫn – Hỏi đáp', crumb: 'Hướng dẫn', lead: 'Cách sử dụng bản đồ, đọc đúng thông tin dự báo, cảnh báo và gửi phản ánh hiện trường.' }) %>
<main class="container page">
  <div class="layout-2r">
    <div class="grid">
      <section class="card card-b">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px"><h2 style="font-size:20px;margin:0;flex:1">Hướng dẫn sử dụng</h2><a class="btn btn-primary btn-sm" href="/huong-dan/su-dung"><%- ic('question-circle-fill') %> Tài liệu hướng dẫn chi tiết (có ảnh minh hoạ)</a></div>
        <div class="grid cols-2">
          <% [['map','Xem bản đồ và lớp dữ liệu','Vào trang Bản đồ, bật/tắt lớp ở cây lớp bên trái; kéo thanh trượt để chỉnh độ mờ ảnh. Chọn “tô màu theo xã” để xem chỉ tiêu theo từng xã. Nhấp vào xã hoặc điểm nóng để xem thông tin ở khung bên phải.'],
              ['gps','Đo đạc, tọa độ, chia sẻ','Thanh công cụ có Đo khoảng cách, Đo diện tích (nhấp liên tiếp các điểm), Tọa độ (nhấp để sao chép), Xuất bản đồ (ảnh PNG), Chia sẻ (liên kết giữ vị trí) và In.'],
              ['fire','Theo dõi cảnh báo cháy','Trang Cảnh báo cháy rừng hiển thị cấp nguy cơ hôm nay và 7 ngày tới cho từng xã, điểm nóng vệ tinh 7 ngày và lịch sử. Chọn ngày ở khung bên trái để đổi bản đồ.'],
              ['violation','Theo dõi biến động rừng','Trang Biến động và dự báo mất rừng liệt kê các vùng nghi vấn mới, bản đồ nguy cơ mất rừng 2025–2026 và lịch sử mất tán cây theo xã.'],
              ['camera','Gửi phản ánh hiện trường','Chọn loại phản ánh, mô tả, chọn vị trí trên bản đồ hoặc nút “Lấy vị trí GPS”, đính kèm ảnh rồi gửi. Lưu mã hồ sơ để tra cứu tiến độ.'],
              ['statistics','Tải số liệu thống kê','Trang Thống kê cho phép xem theo xã, tô màu bản đồ theo chỉ tiêu và tải bảng Excel/CSV kèm ghi chú nguồn.']].forEach(([i,t,d]) => { %>
            <div style="display:flex;gap:12px"><%- cicon(i) %><div><h3 style="font-size:15px"><%= t %></h3><p class="src" style="margin:4px 0 0;font-size:13px"><%= d %></p></div></div>
          <% }) %>
        </div>
      </section>

      <section class="card card-b" id="chay">
        <h2 style="font-size:20px;margin-bottom:10px">Đọc đúng thông tin cảnh báo cháy rừng</h2>
        <div class="grid cols-3">
          <div class="note info"><b>Dự báo nguy cơ cháy</b><br>Mức độ thuận lợi của thời tiết cho phát sinh, lan cháy (chỉ số P, FWI). Không có nghĩa là chắc chắn có cháy.</div>
          <div class="note"><b>Điểm nóng vệ tinh</b><br>Vệ tinh phát hiện điểm nhiệt bất thường. Có thể là đốt nương, đốt thực bì hoặc nguồn nhiệt khác – cần xác minh.</div>
          <div class="note ok"><b>Cháy rừng đã xác nhận</b><br>Chỉ khi lực lượng chuyên môn xác minh tại hiện trường và cập nhật trạng thái.</div>
        </div>
        <table class="tbl" style="margin-top:12px"><thead><tr><th>Cấp</th><th>Chỉ số P</th><th>Ý nghĩa</th></tr></thead><tbody>
          <tr><td><span class="lv lv-1">I</span> Thấp</td><td>≤ 5.000</td><td>Ít có khả năng cháy rừng</td></tr>
          <tr><td><span class="lv lv-2">II</span> Trung bình</td><td>5.001 – 10.000</td><td>Có khả năng cháy rừng</td></tr>
          <tr><td><span class="lv lv-3">III</span> Cao</td><td>10.001 – 15.000</td><td>Có khả năng dễ cháy rừng</td></tr>
          <tr><td><span class="lv lv-4">IV</span> Nguy hiểm</td><td>15.001 – 20.000</td><td>Có khả năng cháy rừng lớn</td></tr>
          <tr><td><span class="lv lv-5">V</span> Cực kỳ nguy hiểm</td><td>&gt; 20.000</td><td>Có khả năng cháy lớn và lan tràn lửa nhanh</td></tr>
        </tbody></table>
        <p class="src">P cộng dồn tích nhiệt độ × độ chênh lệch bão hòa hơi nước qua các ngày liên tiếp có mưa ≤ 5 mm; ngày mưa trên 5 mm thì P về 0. <% if (vd && vd.auc_nesterov_p) { %>Kiểm định 2024–2026 với điểm nóng vệ tinh: AUC <%= fmt.num(vd.auc_nesterov_p, 2) %>.<% } %></p>
      </section>

      <section class="card card-b" id="bien-dong">
        <h2 style="font-size:20px;margin-bottom:10px">Đọc đúng thông tin biến động và dự báo mất rừng</h2>
        <ul style="margin:0;padding-left:18px;line-height:1.75">
          <li><b>Biến động nghi vấn</b>: vùng ảnh Sentinel-2 có NDVI và NBR giảm mạnh so với cùng kỳ hai năm trước, lặp lại ít nhất 2 tháng, trong vùng còn rừng đến 2024. Là đầu vào để kiểm tra, chưa phải kết luận.</li>
          <li><b>Rụng lá theo mùa</b>: rừng khộp rụng lá mạnh mùa khô; các vùng phát hiện trong tháng 1–4 được đánh dấu để loại trừ trường hợp này.</li>
          <li><b>Mất tán cây (Hansen)</b>: diện tích tán cây bị thay thế trong năm, gồm cả khai thác rừng trồng theo chu kỳ.</li>
          <li><b>Nguy cơ mất rừng 2025–2026</b>: xác suất từ mô hình học máy dựa trên lịch sử mất rừng, khoảng cách tới khu canh tác, địa hình. <% if (fv) { %>Kiểm định trên 2023–2024: AUC <%= fmt.num(fv.auc, 2) %>; 10% diện tích nguy cơ cao nhất chứa <%= fmt.num(fv.top10pct_capture * 100, 0) %>% số ô bị mất thực tế.<% } %> Dùng để ưu tiên tuần tra, không dùng để kết luận vi phạm.</li>
        </ul>
      </section>

      <section class="card card-b">
        <h2 style="font-size:20px;margin-bottom:10px">Câu hỏi thường gặp</h2>
        <% [['Vì sao số liệu xã không khớp với ranh tỉnh Kon Tum cũ?','Số liệu chính thức năm 2025 được công bố cho toàn bộ xã hiện hành sau sắp xếp. Một số xã có một phần nhỏ ngoài ranh Kon Tum cũ; bản đồ hiển thị phần trong ranh nhưng số liệu bảng vẫn là toàn xã.'],
            ['Dữ liệu cập nhật khi nào?','Thời tiết hiện tại làm mới mỗi 30 phút; dự báo nguy cơ cháy tính lại khi cập nhật khí tượng (mặc định mỗi 6 giờ); điểm nóng theo bản tải gần nhất từ NASA FIRMS; số liệu rừng theo đợt công bố hằng năm. Mỗi khung thông tin ghi rõ thời điểm.'],
            ['Thông tin cá nhân khi gửi phản ánh có bị công khai không?','Không. Họ tên, số điện thoại, email chỉ cán bộ xử lý được xem. Danh sách công khai chỉ gồm phản ánh đã được tiếp nhận kiểm tra, vị trí làm tròn khoảng 1 km.'],
            ['Tôi thấy cháy rừng, nên làm gì?','Gọi ngay 114 và báo chính quyền, kiểm lâm địa phương. Sau đó có thể gửi phản ánh kèm ảnh, vị trí để hỗ trợ xác minh.'],
            ['Cảnh báo trên trang có phải cảnh báo chính thức không?','Các cấp nguy cơ và vùng nghi vấn được tính tự động. Cảnh báo chính thức là cảnh báo đã được cán bộ có thẩm quyền phê duyệt; trạng thái này được ghi rõ bên cạnh từng cảnh báo.']].forEach(([q,a]) => { %>
          <details class="lt-group" style="border-bottom:1px solid var(--line)"><summary><%- ic('question-circle-fill') %> <%= q %></summary><p style="margin:0 12px 12px 36px" class="muted"><%= a %></p></details>
        <% }) %>
      </section>
    </div>
    <aside class="grid" style="align-content:start">
      <section class="card" style="overflow:hidden"><img src="/assets/items/field-survey-small.webp" alt="" style="width:100%;height:170px;object-fit:cover"><div class="card-b">
        <h2 style="font-size:17px">Thiết bị di động</h2>
        <p class="muted" style="margin:6px 0 0">Website hiển thị tốt trên điện thoại. Có thể dùng định vị GPS và camera của điện thoại khi gửi phản ánh.</p>
        <div style="display:flex;gap:10px;margin-top:10px"><%- cicon('gps') %><%- cicon('camera') %><%- cicon('sync') %><%- cicon('offline') %></div></div></section>
      <section class="card card-b"><h2 style="font-size:17px">Liên hệ hỗ trợ</h2>
        <p class="muted" style="margin:6px 0 0">Đầu mối hỗ trợ kỹ thuật và nghiệp vụ sẽ được cập nhật khi đơn vị chủ quản xác nhận.</p>
        <p style="margin:8px 0 0">Khẩn cấp cháy rừng: <strong>114</strong></p></section>
      <section class="card" style="overflow:hidden"><img src="/assets/items/forest-technology-small.webp" alt="" style="width:100%;height:150px;object-fit:cover"><div class="card-f">Ảnh minh họa.</div></section>
    </aside>
  </div>
</main>
<%- include('../partials/footer') %>
</body></html>
