<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const catIcon = { 'van-ban-phap-ly': 'documents', 'bao-cao-chuyen-nganh': 'report', 'du-lieu-chuyen-nganh': 'database', 'quy-hoach': 'map', 'ban-do-chuyen-de': 'layers', 'huong-dan-ky-thuat': 'guide', khac: 'about' }; %>
<section class="banner">
  <img src="/assets/banners/p07-documents.webp" srcset="/assets/banners/p07-documents-small.webp 960w, /assets/banners/p07-documents.webp 2172w" sizes="100vw" alt="">
  <div class="container">
    <div><h1>Tài liệu – Bản đồ PDF</h1><p>Tra cứu, xem và tải các văn bản, báo cáo, dữ liệu chuyên ngành và bản đồ chuyên đề phục vụ quản lý, bảo vệ và phát triển rừng.</p></div>
    <div style="margin-left:auto;max-width:520px;width:100%">
      <form action="/tai-lieu" class="hero-search" style="max-width:none"><input name="q" value="<%= filter.q || '' %>" placeholder="Tìm kiếm tài liệu, số hiệu, cơ quan ban hành..."><button class="btn btn-primary"><%- ic('search') %></button></form>
      <div style="display:flex;gap:10px;margin-top:10px;flex-wrap:nowrap">
        <a class="bk dark doc-quick" href="/tai-lieu?loai=quy-hoach"><%- cicon('map') %> Bản đồ quy hoạch</a>
        <a class="bk dark doc-quick" href="/tai-lieu?loai=van-ban-phap-ly"><%- cicon('documents') %> Báo cáo – Văn bản</a>
        <a class="bk dark doc-quick" href="/tai-lieu?loai=du-lieu-chuyen-nganh"><%- cicon('database') %> Dữ liệu chuyên ngành</a>
      </div>
    </div>
  </div>
</section>
<div class="container"><div class="crumbs"><a href="/"><%- ic('house-fill') %></a> › <span>Tài liệu – Bản đồ PDF</span><span style="margin-left:auto"><%= docs.length %> kết quả</span></div></div>
<main class="container page">
  <div class="layout-3" style="grid-template-columns:270px minmax(0,1fr) 520px">
    <aside class="grid">
      <section class="card">
        <div class="card-h"><h2><%- ic('grid-fill') %> Danh mục tài liệu</h2></div>
        <ul class="side-menu">
          <li><a href="/tai-lieu" class="<%= !filter.loai ? 'active' : '' %>"><%- cicon('documents') %> Tất cả <span class="count"><%= all.length %></span></a></li>
          <% Object.entries(categories).forEach(([k, l]) => { %><li><a href="/tai-lieu?loai=<%= k %>" class="<%= filter.loai === k ? 'active' : '' %>"><%- cicon(catIcon[k]) %> <%= l %> <span class="count"><%= counts[k] %></span></a></li><% }) %>
        </ul>
      </section>
      <form class="card card-b" action="/tai-lieu">
        <h3 style="font-size:15px;margin-bottom:10px;display:flex;gap:8px;align-items:center"><%- ic('funnel-fill') %> Bộ lọc tìm kiếm</h3>
        <label class="field"><span>Loại tài liệu</span><select class="input" name="loai"><option value="">Tất cả</option><% Object.entries(categories).forEach(([k, l]) => { %><option value="<%= k %>" <%= filter.loai === k ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
        <label class="field"><span>Cơ quan ban hành</span><select class="input" name="co_quan"><option value="">Tất cả</option><% issuers.forEach(i => { %><option <%= filter.co_quan === i ? 'selected' : '' %>><%= i %></option><% }) %></select></label>
        <label class="field"><span>Từ khóa</span><input class="input" name="q" value="<%= filter.q || '' %>" placeholder="Nhập từ khóa..."></label>
        <button class="btn btn-primary btn-block"><%- ic('search') %> Tìm kiếm</button>
        <a class="btn btn-outline btn-block" style="margin-top:8px" href="/tai-lieu">Đặt lại bộ lọc</a>
      </form>
    </aside>

    <section class="card">
      <div class="card-h"><h2><%- ic('folder-fill') %> Danh sách tài liệu và bản đồ</h2></div>
      <div class="card-b">
        <% if (!docs.length) { %><div class="empty-state"><%- ic('folder-fill') %>Không có tài liệu phù hợp.</div><% } %>
        <div class="doc-grid">
          <% const pgD = paginate(docs, query.trang, 9); pgD.items.forEach(d => { %>
            <a class="doc-card <%= selected && selected.id === d.id ? 'sel' : '' %>" href="<%= pageUrl(pgD.page) %>&id=<%= d.id %>">
              <div class="doc-thumb"><% if (d.thumbnail) { %><img src="<%= d.thumbnail %>" alt="Trang đầu <%= d.title %>" loading="lazy"><% } else { %><img src="/assets/icons/colored/<%= d.type === 'xlsx' ? 'excel' : 'pdf' %>.svg" alt="" style="width:70px;height:70px;object-fit:contain"><% } %></div>
              <h3><%= d.title %></h3>
              <div class="meta"><span class="badge b-green"><%= d.categoryLabel %></span><span class="badge b-red"><%= d.type.toUpperCase() %></span></div>
              <div class="meta"><span><%- ic('calendar3') %> <%= d.issued ? fmt.ymd(d.issued) : '—' %></span><span><%= fmt.bytes(d.bytes) %></span><% if (d.pages) { %><span><%= d.pages %> trang</span><% } %></div>
            </a>
          <% }) %>
        </div>
        <%- include('../partials/pager', { pg: pgD }) %>
        <p class="src" style="margin-top:12px">Văn bản là bản sao giữ nguyên của tệp công bố trên cổng thông tin cơ quan ban hành, kèm mã kiểm tra SHA-256. Bản đồ chuyên đề PDF được bổ sung khi cơ quan quản lý cung cấp.</p>
      </div>
    </section>

    <aside class="card" style="position:sticky;top:84px">
      <% if (!selected) { %><div class="empty-state">Chọn một tài liệu để xem trước.</div><% } else { %>
        <div class="card-h"><h2><%- ic('file-earmark-pdf-fill') %> <%= selected.title %></h2></div>
        <div class="card-b">
          <% if (selected.type === 'pdf') { %><iframe class="pdf-frame" src="<%= selected.url %>#view=FitH" title="<%= selected.title %>" loading="lazy"></iframe>
          <% } else if (selected.preview) { %><a href="<%= selected.preview %>" target="_blank" rel="noopener"><img src="<%= selected.preview %>" alt="<%= selected.title %>" style="width:100%;max-height:520px;object-fit:contain;background:#f1f4f6;border-radius:8px;border:1px solid var(--line)"></a>
          <% } else { %><div class="empty-state"><img src="/assets/icons/colored/<%= selected.type === 'xlsx' ? 'excel' : 'database' %>.svg" alt="" width="70"><p><%= selected.type === 'mpk' ? 'Gói bản đồ ArcGIS (.mpk) – tải về và mở bằng ArcGIS.' : 'Tệp bảng tính – tải về để xem.' %></p></div><% } %>
          <% if (selected.origin === 'map') { %><div class="note <%= selected.georeferenced ? 'ok' : '' %>" style="margin-top:8px"><%= selected.georeferenced ? 'Bản đồ đã định vị – có thể bật lớp trên Bản đồ WebGIS.' : 'Bản đồ chưa nắn chỉnh toạ độ: chỉ xem như tài liệu, không chồng lên bản đồ.' %><% if (selected.georeferenced) { %> <a href="/ban-do?lop=m-<%= selected.mapId %>">Mở trên bản đồ</a><% } %></div><% } %>
          <div style="display:flex;gap:8px;margin:12px 0">
            <a class="btn btn-primary" style="flex:1" href="<%= selected.url %>?tai=1"><%- ic('download') %> Tải xuống</a>
            <a class="btn btn-outline" style="flex:1" href="<%= selected.url %>" target="_blank" rel="noopener"><%- ic('fullscreen') %> Xem toàn màn hình</a>
            <button class="btn btn-outline" style="flex:1" type="button" onclick="navigator.clipboard.writeText(location.origin + '/tai-lieu?id=<%= selected.id %>'); this.textContent='Đã sao chép'"><%- ic('share-fill') %> Chia sẻ</button>
          </div>
          <h3 style="font-size:14.5px;margin-bottom:6px"><%- ic('info-circle-fill') %> Thông tin tài liệu</h3>
          <table class="kv">
            <tr><td>Loại tài liệu</td><td><%= selected.categoryLabel %></td></tr>
            <% if (selected.number) { %><tr><td>Số hiệu</td><td><%= selected.number %></td></tr><% } %>
            <tr><td>Ngày ban hành</td><td><%= selected.issued ? fmt.ymd(selected.issued) : '—' %></td></tr>
            <tr><td>Cơ quan ban hành</td><td><%= selected.issuer || '—' %></td></tr>
            <tr><td>Dung lượng</td><td><%= fmt.bytes(selected.bytes) %><%= selected.pages ? ' · ' + selected.pages + ' trang' : '' %></td></tr>
            <tr><td>Định dạng</td><td><%= selected.type.toUpperCase() %></td></tr>
            <% if (selected.source) { %><tr><td>Nguồn gốc</td><td><a href="<%= selected.source %>" target="_blank" rel="noopener">Cổng thông tin cơ quan ban hành</a></td></tr><% } %>
            <% if (selected.sha256) { %><tr><td>SHA-256</td><td class="src" style="word-break:break-all"><%= selected.sha256 %></td></tr><% } %>
            <% if (selected.description) { %><tr><td>Mô tả</td><td><%= selected.description %></td></tr><% } %>
          </table>
          <% const rel = all.filter(d => d.id !== selected.id && d.category === selected.category).slice(0, 3); if (rel.length) { %>
            <h3 style="font-size:14.5px;margin:14px 0 6px"><%- ic('collection-fill') %> Tài liệu liên quan</h3>
            <div class="grid cols-3"><% rel.forEach(d => { %><a href="/tai-lieu?id=<%= d.id %>" style="font-size:12.5px"><div class="doc-thumb" style="max-height:110px"><% if (d.thumbnail) { %><img src="<%= d.thumbnail %>" alt=""><% } else { %><%- ic('file-earmark-text-fill') %><% } %></div><%= d.title.slice(0, 60) %></a><% }) %></div>
          <% } %>
        </div>
      <% } %>
    </aside>
  </div>
</main>
<%- include('../partials/footer') %>
</body></html>
