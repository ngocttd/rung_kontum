<%- include('_top') %>
<div class="adm-tabs"><a class="on" href="#">Danh sách</a><a href="#cap-nhat">Cập nhật số liệu năm mới</a><a href="/quan-tri/tai-nguyen/lop-phu">Chuỗi lớp phủ hằng năm</a><a href="/thong-ke/xuat.xlsx?nam=<%= summary.year %>">Export Excel</a><a href="/tai-nguyen-rung?tab=hien-trang" target="_blank">Xem trang công khai</a></div>
<section class="card">
  <div class="card-h"><h2><%- ic('tree-fill') %> Hiện trạng rừng <%= D.forestAsOf %> theo xã/phường</h2><span class="more muted" style="font-weight:400;margin-left:auto">Năm số liệu <select class="input input-sm" style="width:auto;display:inline-block" onchange="location.search='?nam='+this.value"><% years.slice().reverse().forEach(y => { %><option value="<%= y.year %>" <%= y.year === summary.year ? 'selected' : '' %>><%= y.year %> – <%= y.decision %></option><% }) %></select></span></div>
  <div class="card-b"><div class="table-wrap"><table class="tbl" data-page-size="15" data-tools="Tìm xã/phường…"><thead><tr><th>STT</th><th>Xã/phường</th><th class="num">Có rừng (ha)</th><th class="num">Rừng tự nhiên (ha)</th><th class="num">Rừng trồng (ha)</th><th class="num">Che phủ (%)</th><th class="num">QH đặc dụng (ha)</th><th class="num">QH phòng hộ (ha)</th><th class="num">QH sản xuất (ha)</th></tr></thead><tbody>
    <% communes.forEach((c, i) => { const o = c.official; %><tr><td><%= i + 1 %></td><td title="Nguồn: <%= o.source_sheet %>, dòng <%= o.source_row %> – <%= D.decision %>"><%= c.fullName %></td><td class="num"><%= fmt.num(o.established_forest_ha) %></td><td class="num"><%= fmt.num(o.natural_forest_ha) %></td><td class="num"><%= fmt.num(o.established_plantation_ha) %></td><td class="num"><%= fmt.num(o.official_forest_cover_percent, 2) %></td><td class="num"><%= fmt.num(o.special_use_planning_ha) %></td><td class="num"><%= fmt.num(o.protection_planning_ha) %></td><td class="num"><%= fmt.num(o.production_planning_ha) %></td></tr><% }) %>
  </tbody><tfoot><tr><td></td><td>Tổng 40 xã/phường</td><td class="num"><%= fmt.num(summary.established_forest_ha) %></td><td class="num"><%= fmt.num(summary.natural_forest_ha) %></td><td class="num"><%= fmt.num(summary.plantation_ha) %></td><td class="num"><%= fmt.num(summary.cover_percent_computed, 2) %></td><td class="num"><%= fmt.num(summary.special_use_ha) %></td><td class="num"><%= fmt.num(summary.protection_ha) %></td><td class="num"><%= fmt.num(summary.production_ha) %></td></tr></tfoot></table></div></div>
  <div class="card-f">Nguồn: Biểu 4 – <%= D.decision %> ngày <%= D.decisionDate %> (rê chuột lên tên xã để xem dòng trong biểu). Diện tích quy hoạch 3 loại rừng gồm cả đất chưa có rừng nên có xã quy hoạch sản xuất lớn hơn diện tích có rừng. Số liệu chính thức chỉ đọc; khi có quyết định mới dùng mục “Cập nhật số liệu năm mới” bên dưới.</div>
</section>
<section class="card" id="cap-nhat" style="margin-top:16px">
  <div class="card-h"><h2><%- ic('cloud-arrow-up-fill') %> Cập nhật số liệu hiện trạng theo quyết định công bố mới</h2></div>
  <div class="card-b">
    <p class="src" style="margin:0 0 8px">Khi tỉnh công bố hiện trạng rừng năm mới: tải phụ lục Excel của quyết định (sheet Biểu 4 – hiện trạng rừng theo đơn vị hành chính, mẫu Thông tư 33/2018/TT-BNNPTNT). Hệ thống kiểm tra khớp 40 xã và tổng diện tích để xem trước, bấm “Nạp số liệu” để dùng. Số liệu các năm trước được giữ, người dùng chọn năm ở trang Tài nguyên rừng và Thống kê. Năm hiện có: <b><%= years.map(y => y.year + ' (' + y.decision + ')').join(', ') %></b>.</p>
    <% if (pending) { const r = pending.report; %>
      <div class="note <%= r.matched === r.expected ? 'ok' : 'warn' %>"><b>Kết quả kiểm tra <%= pending.original %>:</b> năm <%= r.year %>, sheet “<%= r.sheet %>”, khớp <b><%= r.matched %>/<%= r.expected %></b> xã<%= r.missing.length ? ' (chưa khớp: ' + r.missing.join(', ') + ')' : '' %>. Tổng: diện tích tự nhiên <%= fmt.num(r.natural_area_ha) %> ha, có rừng <b><%= fmt.num(r.established_forest_ha) %> ha</b> (tự nhiên <%= fmt.num(r.natural_forest_ha) %>, trồng <%= fmt.num(r.plantation_ha) %>), che phủ <%= fmt.num(r.cover_percent, 2) %>%.<% if (years.some(y => y.year === r.year)) { %> <b>Năm <%= r.year %> đã có – nạp sẽ thay số liệu năm này.</b><% } %></div>
      <form method="post" action="/quan-tri/tai-nguyen/so-lieu/xac-nhan" style="display:flex;gap:8px;margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary"><%- ic('check-lg') %> Nạp số liệu năm <%= r.year %></button><button class="btn btn-outline" name="action" value="cancel">Huỷ</button></form>
    <% } else if (can('data.manage')) { %>
    <form method="post" action="/quan-tri/tai-nguyen/so-lieu" enctype="multipart/form-data" class="grid cols-3" style="gap:8px"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Phụ lục Excel (.xlsx) *</span><input class="input" type="file" name="file" accept=".xlsx" required></label>
      <label class="field"><span>Số liệu tính đến ngày *</span><input class="input" type="date" name="as_of" required></label>
      <label class="field"><span>Số quyết định *</span><input class="input" name="decision" required placeholder="vd 123/QĐ-UBND"></label>
      <label class="field"><span>Ngày quyết định * (dd/mm/yyyy)</span><input class="input" name="decision_date" required pattern="\d{2}/\d{2}/\d{4}" placeholder="31/03/2027"></label>
      <label class="field"><span>Tên sheet (để trống: tự tìm “Biểu 4”)</span><input class="input" name="sheet"></label>
      <label class="field"><span>Liên kết văn bản gốc</span><input class="input" name="url" placeholder="https://…"></label>
      <div style="grid-column:1/-1"><button class="btn btn-primary"><%- ic('search') %> Kiểm tra số liệu</button></div>
    </form>
    <% } %>
  </div>
</section>
<%- include('_bottom') %>
</body></html>
