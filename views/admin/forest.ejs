<%- include('_top') %>
<div class="adm-tabs"><a class="on" href="#">Danh sách</a><a href="/thong-ke/xuat.xlsx">Export Excel</a><a href="/tai-nguyen-rung?tab=hien-trang" target="_blank">Xem trang công khai</a></div>
<section class="card">
  <div class="card-h"><h2><%- ic('tree-fill') %> Hiện trạng rừng 31/12/2025 theo xã/phường</h2><span class="more muted" style="font-weight:400"><%= summary.decision %></span></div>
  <div class="card-b table-wrap"><table class="tbl" data-page-size="15"><thead><tr><th>STT</th><th>Xã/phường</th><th class="num">Tổng DT có rừng (ha)</th><th class="num">Rừng tự nhiên (ha)</th><th class="num">Rừng trồng (ha)</th><th class="num">Độ che phủ (%)</th><th class="num">Đặc dụng</th><th class="num">Phòng hộ</th><th class="num">Sản xuất</th><th>Nguồn</th><th>Ghép mã</th></tr></thead><tbody>
    <% communes.forEach((c, i) => { const o = c.official; %><tr><td><%= i + 1 %></td><td><%= c.fullName %></td><td class="num"><%= fmt.num(o.established_forest_ha) %></td><td class="num"><%= fmt.num(o.natural_forest_ha) %></td><td class="num"><%= fmt.num(o.established_plantation_ha) %></td><td class="num"><%= fmt.num(o.official_forest_cover_percent, 2) %></td><td class="num"><%= fmt.num(o.special_use_planning_ha) %></td><td class="num"><%= fmt.num(o.protection_planning_ha) %></td><td class="num"><%= fmt.num(o.production_planning_ha) %></td><td class="src"><%= o.source_sheet %> dòng <%= o.source_row %></td><td class="src"><%= o.match_method %></td></tr><% }) %>
  </tbody><tfoot><tr><td></td><td>Tổng</td><td class="num"><%= fmt.num(summary.established_forest_ha) %></td><td class="num"><%= fmt.num(summary.natural_forest_ha) %></td><td class="num"><%= fmt.num(summary.plantation_ha) %></td><td class="num"><%= fmt.num(summary.cover_percent_computed, 2) %></td><td class="num"><%= fmt.num(summary.special_use_ha) %></td><td class="num"><%= fmt.num(summary.protection_ha) %></td><td class="num"><%= fmt.num(summary.production_ha) %></td><td></td><td></td></tr></tfoot></table></div>
  <div class="card-f">Số liệu chính thức chỉ đọc; cập nhật bằng cách chạy lại <code>scripts/prepare_official_statistics.py</code> khi có quyết định công bố mới. <% if (validation) { %>Kiểm tra đối chiếu tổng: <%= JSON.stringify(validation).slice(0, 160) %>…<% } %> Lớp lô/khoảnh/tiểu khu, chủ rừng cần cơ quan quản lý bàn giao.</div>
</section>
<%- include('_bottom') %>
</body></html>
