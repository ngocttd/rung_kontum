<%- include('_top') %>
<div class="adm-tabs"><a class="on" href="#">Danh sách</a><a href="/thong-ke/xuat.xlsx">Export Excel</a><a href="/tai-nguyen-rung?tab=hien-trang" target="_blank">Xem trang công khai</a></div>
<section class="card">
  <div class="card-h"><h2><%- ic('tree-fill') %> Hiện trạng rừng 31/12/2025 theo xã/phường</h2><span class="more muted" style="font-weight:400"><%= summary.decision %></span></div>
  <div class="card-b"><div class="table-wrap"><table class="tbl" data-page-size="15" data-tools="Tìm xã/phường…"><thead><tr><th>STT</th><th>Xã/phường</th><th class="num">Có rừng (ha)</th><th class="num">Rừng tự nhiên (ha)</th><th class="num">Rừng trồng (ha)</th><th class="num">Che phủ (%)</th><th class="num">QH đặc dụng (ha)</th><th class="num">QH phòng hộ (ha)</th><th class="num">QH sản xuất (ha)</th></tr></thead><tbody>
    <% communes.forEach((c, i) => { const o = c.official; %><tr><td><%= i + 1 %></td><td title="Nguồn: <%= o.source_sheet %>, dòng <%= o.source_row %> – QĐ 1047/QĐ-UBND"><%= c.fullName %></td><td class="num"><%= fmt.num(o.established_forest_ha) %></td><td class="num"><%= fmt.num(o.natural_forest_ha) %></td><td class="num"><%= fmt.num(o.established_plantation_ha) %></td><td class="num"><%= fmt.num(o.official_forest_cover_percent, 2) %></td><td class="num"><%= fmt.num(o.special_use_planning_ha) %></td><td class="num"><%= fmt.num(o.protection_planning_ha) %></td><td class="num"><%= fmt.num(o.production_planning_ha) %></td></tr><% }) %>
  </tbody><tfoot><tr><td></td><td>Tổng 40 xã/phường</td><td class="num"><%= fmt.num(summary.established_forest_ha) %></td><td class="num"><%= fmt.num(summary.natural_forest_ha) %></td><td class="num"><%= fmt.num(summary.plantation_ha) %></td><td class="num"><%= fmt.num(summary.cover_percent_computed, 2) %></td><td class="num"><%= fmt.num(summary.special_use_ha) %></td><td class="num"><%= fmt.num(summary.protection_ha) %></td><td class="num"><%= fmt.num(summary.production_ha) %></td></tr></tfoot></table></div></div>
  <div class="card-f">Nguồn: Biểu 4 – QĐ 1047/QĐ-UBND (rê chuột lên tên xã để xem dòng trong biểu). Diện tích quy hoạch 3 loại rừng gồm cả đất chưa có rừng nên có xã quy hoạch sản xuất lớn hơn diện tích có rừng. Số liệu chính thức chỉ đọc; cập nhật bằng <code>scripts/prepare_official_statistics.py</code> khi có quyết định công bố mới.</div>
</section>
<%- include('_bottom') %>
</body></html>
