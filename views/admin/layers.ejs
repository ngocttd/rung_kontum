<%- include('_top') %>
<% const stB = { published: ['b-green', 'Hoạt động'], staging: ['b-orange', 'Chờ duyệt'], invalid: ['b-red', 'Lỗi kiểm tra'] }; %>
<div class="adm-tabs"><a class="on" href="#ds">Danh sách lớp dữ liệu</a><% if (can('data.manage')) { %><a href="#them">Nhập lớp (GeoJSON / Shapefile / Excel)</a><% } %><a href="/quan-tri/huong-dan#api-lop">API quản lý lớp</a></div>
<section class="card" id="ds">
  <div class="card-h"><h2><%- ic('layers-fill') %> Lớp dữ liệu bản đồ</h2></div>
  <div class="card-b table-wrap"><table class="tbl" data-page-size="15"><thead><tr><th>STT</th><th>Tên lớp dữ liệu</th><th>Loại dữ liệu</th><th>Nguồn</th><th>Độ phân giải</th><th>Ghi chú</th><th>Trạng thái</th><th data-sort="off">Thao tác</th></tr></thead><tbody>
    <% layers.forEach((l, i) => { %><tr><td><%= i + 1 %></td><td><%= l.title %></td><td><%= l.kind %></td><td><%= l.source %></td><td><%= l.resolution || '—' %></td><td class="src"><%= l.meaning || '' %></td><td><span class="badge b-green">Hoạt động</span></td><td class="src">Pipeline Python</td></tr><% }) %>
    <% custom.forEach((l, i) => { %><tr><td><%= layers.length + i + 1 %></td><td><span class="dot" style="background:<%= l.style.color %>"></span> <%= l.title %></td><td><%= l.validation.source_format ? { '.zip': 'Shapefile', '.xlsx': 'Excel', '.csv': 'CSV', '.geojson': 'GeoJSON', '.json': 'GeoJSON' }[l.validation.source_format] || 'GeoJSON' : 'GeoJSON' %> (<%= (l.validation.types || []).join(', ') %>) · <%= l.validation.count || 0 %> đối tượng<% if (l.validation.source_crs && l.validation.source_crs !== 'EPSG:4326') { %><div class="src">chuyển từ <%= l.validation.source_crs %></div><% } %></td><td><%= l.source || '—' %></td><td>—</td>
      <td class="src"><%= l.validation.errors.length ? l.validation.errors.join('; ') : l.description %><br>Tải lên bởi <%= l.uploaded_by %> · <%= fmt.dateTime(l.created_at) %></td><td><span class="badge <%= stB[l.status][0] %>"><%= stB[l.status][1] %></span></td>
      <td><% if (can('data.manage')) { %><form method="post" action="/quan-tri/du-lieu/<%= l.id %>/trang-thai" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (l.status === 'staging') { %><button class="btn btn-primary btn-sm" name="action" value="published">Duyệt công bố</button><% } %>
        <% if (l.status === 'published') { %><button class="btn btn-outline btn-sm" name="action" value="staging">Gỡ công bố</button><% } %>
        <button class="btn btn-outline btn-sm" name="action" value="delete" onclick="return confirm('Xóa lớp này?')"><%- ic('trash-fill') %></button></form>
        <details class="row-edit"><summary class="src"><%- ic('pencil-fill') %> Sửa</summary><form method="post" action="/quan-tri/du-lieu/<%= l.id %>/sua" class="grid" style="gap:6px;margin-top:6px;min-width:220px"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <input class="input" name="title" value="<%= l.title %>" required><input class="input" name="source" value="<%= l.source || '' %>" placeholder="Nguồn"><textarea class="input" name="description" rows="2" placeholder="Mô tả"><%= l.description || '' %></textarea>
          <input class="input" type="color" name="color" value="<%= (l.style && l.style.color) || '#00bcd4' %>" style="height:34px"><button class="btn btn-primary btn-sm">Lưu</button></form></details><% } %></td></tr><% }) %>
  </tbody></table></div>
  <div class="card-f">Ranh giới: nguồn <%= manifest && manifest.source_version ? manifest.source_version.DatasetVersion : '' %> (commit <%= manifest ? String(manifest.source_commit).slice(0, 8) : '' %>). Các lớp raster được dựng lại bằng job “Dựng lại lớp ảnh bản đồ” ở mục Phân tích.</div>
</section>
<% if (can('data.manage')) { %>
<form class="card" id="them" style="margin-top:16px" method="post" action="/quan-tri/du-lieu/tai-len" enctype="multipart/form-data">
  <div class="card-h"><h2><%- ic('upload') %> Nhập lớp dữ liệu (GeoJSON, Shapefile, Excel, CSV)</h2></div>
  <div class="card-b grid cols-4">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Tên lớp *</span><input class="input" name="title" required></label>
    <label class="field"><span>Nguồn / cơ quan cung cấp</span><input class="input" name="source"></label>
    <label class="field"><span>Màu hiển thị</span><input class="input" type="color" name="color" value="#00bcd4" style="height:40px"></label>
    <label class="field"><span>Tệp dữ liệu * (≤ 25 MB)</span><input class="input" type="file" name="file" accept=".geojson,.json,.zip,.xlsx,.csv" required></label>
    <label class="field"><span>Hệ toạ độ nguồn</span><select class="input" name="crs"><option value="auto">Tự nhận (theo .prj / độ lớn toạ độ)</option><option value="EPSG:4326">WGS84 kinh độ/vĩ độ (EPSG:4326)</option><option value="VN2000-KT">VN-2000 múi 3° KT 107°45′ (Kon Tum)</option><option value="VN2000-UTM48">VN-2000 UTM múi 48 (6°)</option><option value="EPSG:32648">WGS84 / UTM 48N (EPSG:32648)</option></select></label>
    <label class="field" style="grid-column:1/-1"><span>Mô tả, phạm vi, năm dữ liệu</span><textarea class="input" name="description" rows="2"></textarea></label>
    <div style="grid-column:1/-1"><button class="btn btn-primary"><%- ic('upload') %> Tải lên và kiểm tra</button>
      <span class="src" style="margin-left:10px">Shapefile: nén .shp, .shx, .dbf, .prj (và .cpg nếu có) thành một tệp .zip. Excel/CSV: dòng đầu là tiêu đề, có cột <b>lon/lat</b> (kinh độ/vĩ độ) hoặc <b>x/y</b> (mét – chọn hệ toạ độ); các cột còn lại thành thuộc tính. Quy trình: chuyển về WGS84 → kiểm tra hình học → vùng chờ → người có quyền duyệt công bố → hiển thị trong “Lớp vector bổ sung” của bản đồ.</span></div>
  </div>
</form>
<% } %>
<%- include('_bottom') %>
</body></html>
