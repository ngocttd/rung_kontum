<%- include('_top') %>
<% const stB = { published: ['b-green', 'Đang công bố'], staging: ['b-orange', 'Chờ duyệt'], invalid: ['b-red', 'Lỗi kiểm tra'] };
   const kindL = { overlay: 'Ảnh/raster', map: 'Bản đồ chuyên đề', vector: 'Vector', choro: 'Tô màu theo xã', custom: 'Vector bổ sung' };
   const srcL = { system: 'Hệ thống', auto: 'Tự sinh theo lịch', map: 'Bản đồ PDF/GeoTIFF', custom: 'Tải lên' };
   const edit = can('data.manage'); const fmtL = { '.zip': 'Shapefile', '.xlsx': 'Excel', '.csv': 'CSV', '.geojson': 'GeoJSON', '.json': 'GeoJSON' }; %>
<div class="adm-tabs"><a class="on" href="/quan-tri/du-lieu">Lớp dữ liệu bản đồ (<%= catalog.filter(i => !i.deleted).length %>)</a><a href="/quan-tri/du-lieu/danh-muc">Danh mục nhóm lớp (<%= groups.length %>)</a><a href="#vector">Lớp vector bổ sung (<%= custom.length %>)</a><% if (edit) { %><a href="#them">Nhập lớp (GeoJSON / Shapefile / Excel)</a><% } %><a href="/quan-tri/du-lieu/api">API chia sẻ</a></div>

<section class="card" id="danh-muc">
  <div class="card-h"><h2><%- ic('layers-fill') %> Lớp dữ liệu bản đồ</h2><a class="btn btn-outline btn-sm" style="margin-left:auto" href="/quan-tri/du-lieu/danh-muc"><%- ic('collection-fill') %> Quản lý danh mục nhóm</a></div>
  <div class="card-b">
    <div class="note info" style="margin:0 0 10px">Trang này quản lý từng <b>lớp</b> (nhóm lớp quản lý ở <a href="/quan-tri/du-lieu/danh-muc">Danh mục nhóm lớp</a>) – quyết định lớp nào hiện trên Bản đồ WebGIS, MobileGIS, trang Tài nguyên rừng và API chia sẻ. Cách dùng: sửa trực tiếp ô <b>Nhóm, Tên hiển thị, Thứ tự</b> hoặc đánh dấu <b>Bật sẵn</b> (bật khi mở bản đồ), <b>Tài nguyên rừng</b> (hiện ở trang Tài nguyên rừng) → nút <b>“Lưu thay đổi”</b> của dòng đó sáng lên, bấm để lưu. <b>Ẩn/Hiện</b>: tạm gỡ khỏi bản đồ (giữ cấu hình). <b>Xoá</b>: lớp vector bổ sung và bản đồ chuyên đề bị xoá hẳn dữ liệu; lớp hệ thống/tự sinh chỉ gỡ khỏi danh mục (khôi phục được ở cuối trang). Lớp mới (thời tiết, phân tích biến động, phân loại ảnh, bản đồ PDF/GeoTIFF đã xuất bản, vector đã duyệt) tự vào danh mục.</div>
    <div class="table-wrap"><table class="tbl" data-page-size="25" data-tools="Tìm lớp, nhóm, nguồn…"><thead><tr><th>Nhóm</th><th>Tên hiển thị</th><th>Loại · nguồn</th><th class="num">Thứ tự</th><th>Bật sẵn</th><th>Tài nguyên rừng</th><th>Trạng thái</th><th data-sort="off">Thao tác</th></tr></thead><tbody>
    <% catalog.filter(i => !i.deleted && (!query.nhom || i.group === query.nhom)).forEach(it => { const f = 'f-' + it.id.replace(/[^\w-]/g, ''); %><tr class="<%= it.hidden ? 'row-muted' : '' %>">
      <td data-sort="<%= groups.findIndex(g => g.key === it.group) %>"><% if (edit) { %><select class="input input-sm" name="grp" form="<%= f %>" style="min-width:190px;max-width:230px"><% groups.forEach(g => { %><option value="<%= g.key %>" <%= g.key === it.group ? 'selected' : '' %>><%= g.title %></option><% }) %></select><% } else { %><%= (groups.find(g => g.key === it.group) || {}).title %><% } %><span hidden><%= (groups.find(g => g.key === it.group) || {}).title %></span></td>
      <td data-sort="<%= it.title %>"><% if (edit) { %><input class="input input-sm" name="title" value="<%= it.title %>" form="<%= f %>" style="min-width:220px"><% } else { %><%= it.title %><% } %><span hidden><%= it.title %> <%= it.full_title || '' %></span>
        <% if (it.duplicate) { %><div class="src" style="color:#b45309"><%= it.duplicate %></div><% } %><% if (it.customized) { %><div class="src">đã chỉnh bởi <%= it.customized.by %></div><% } %></td>
      <td class="src"><%= kindL[it.kind] %> · <%= srcL[it.source] %><div title="<%= it.info %>"><%= String(it.info || '').slice(0, 90) %><%= String(it.info || '').length > 90 ? '…' : '' %></div></td>
      <td class="num" data-sort="<%= it.sort %>"><% if (edit) { %><input class="input input-sm" type="number" name="sort" value="<%= it.sort %>" form="<%= f %>" style="width:72px"><% } else { %><%= it.sort %><% } %></td>
      <td data-sort="<%= it.default_on ? 1 : 0 %>"><input type="checkbox" name="default_on" value="1" form="<%= f %>" <%= it.default_on ? 'checked' : '' %> <%= edit ? '' : 'disabled' %>></td>
      <td data-sort="<%= it.on_forest ? 1 : 0 %>"><input type="checkbox" name="on_forest" value="1" form="<%= f %>" <%= it.on_forest ? 'checked' : '' %> <%= edit ? '' : 'disabled' %> <%= ['overlay', 'map', 'vector'].includes(it.kind) ? '' : 'hidden' %>></td>
      <td data-sort="<%= it.hidden ? 1 : 0 %>"><span class="badge <%= it.hidden ? 'b-gray' : 'b-green' %>"><%= it.hidden ? 'Đang ẩn' : 'Hiển thị' %></span></td>
      <td class="layer-acts">
        <% if (edit) { %><form id="<%= f %>" method="post" action="/quan-tri/du-lieu/lop/<%= encodeURIComponent(it.id) %>" style="display:inline" data-row-form><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="hidden" value="<%= it.hidden ? '1' : '0' %>"><button class="btn btn-primary btn-sm" disabled title="Sửa ô trong dòng rồi bấm để lưu"><%- ic('check-lg') %> Lưu thay đổi</button></form>
        <form method="post" action="/quan-tri/du-lieu/lop/<%= encodeURIComponent(it.id) %>/an-hien" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="hidden" value="<%= it.hidden ? '0' : '1' %>"><button class="btn btn-outline btn-sm" title="<%= it.hidden ? 'Hiện lại trên bản đồ' : 'Tạm ẩn khỏi bản đồ' %>"><%- ic(it.hidden ? 'eye-fill' : 'eye-slash-fill') %> <%= it.hidden ? 'Hiện' : 'Ẩn' %></button></form>
        <form method="post" action="/quan-tri/du-lieu/lop/<%= encodeURIComponent(it.id) %>/xoa" style="display:inline" onsubmit="return confirm('<%= it.kind === 'custom' || it.kind === 'map' ? 'Xoá hẳn lớp và dữ liệu? Không hoàn tác được.' : 'Gỡ lớp hệ thống khỏi danh mục? (dữ liệu giữ nguyên, khôi phục được)' %>')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm btn-danger-o" title="<%= it.kind === 'custom' || it.kind === 'map' ? 'Xoá lớp và dữ liệu' : 'Gỡ khỏi danh mục' %>"><%- ic('trash-fill') %> Xoá</button></form>
        <% if (it.customized) { %><form method="post" action="/quan-tri/du-lieu/lop/<%= encodeURIComponent(it.id) %>/mac-dinh" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm" title="Khôi phục cấu hình mặc định"><%- ic('arrow-repeat') %></button></form><% } %><% } %>
        <% if (!it.hidden && it.kind !== 'choro') { %><a class="btn btn-outline btn-sm" href="/ban-do?lop=<%= encodeURIComponent(it.id) %>" target="_blank" title="Xem trên bản đồ"><%- ic('map-fill') %></a><% } %>
        <a class="btn btn-outline btn-sm" href="/api/v1/catalog/<%= encodeURIComponent(it.id) %>" target="_blank" title="API chia sẻ của lớp"><%- ic('code-slash') %></a>
        <% if (it.kind === 'map') { %><a class="btn btn-outline btn-sm" href="/quan-tri/ban-do/<%= it.map_id %>" title="Quản lý bản đồ (thu hồi, nắn chỉnh)"><%- ic('gear-fill') %></a><% } %>
      </td></tr><% }) %>
    </tbody></table></div>
  </div>
</section>

<% const removed = catalog.filter(i => i.deleted); if (removed.length) { %>
<section class="card" style="margin-top:16px"><div class="card-h"><h2><%- ic('archive-fill') %> Lớp đã gỡ khỏi danh mục (<%= removed.length %>)</h2></div>
  <div class="card-b table-wrap"><table class="tbl" data-tools="off"><thead><tr><th>Tên lớp</th><th>Loại</th><th>Gỡ bởi</th><th></th></tr></thead><tbody>
  <% removed.forEach(it => { %><tr><td><%= it.title %></td><td class="src"><%= kindL[it.kind] %> · <%= srcL[it.source] %></td><td class="src"><%= it.customized ? it.customized.by : '' %></td>
    <td><% if (edit) { %><form method="post" action="/quan-tri/du-lieu/lop/<%= encodeURIComponent(it.id) %>/khoi-phuc"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm"><%- ic('arrow-repeat') %> Khôi phục</button></form><% } %></td></tr><% }) %>
  </tbody></table></div></section>
<% } %>
<section class="card" id="vector" style="margin-top:16px">
  <div class="card-h"><h2><%- ic('vector-pen') %> Lớp vector bổ sung (tải lên / API)</h2></div>
  <div class="card-b table-wrap"><% if (!custom.length) { %><div class="empty-state">Chưa có lớp vector bổ sung. Dùng thẻ “Nhập lớp” hoặc API để thêm.</div><% } else { %>
  <table class="tbl" data-page-size="15"><thead><tr><th>Tên lớp</th><th>Dữ liệu</th><th>Nguồn</th><th>Ghi chú</th><th>Trạng thái</th><th data-sort="off">Thao tác</th></tr></thead><tbody>
    <% custom.forEach(l => { %><tr><td><span class="dot" style="background:<%= l.style.color %>"></span> <%= l.title %></td>
      <td><%= fmtL[l.validation.source_format] || 'GeoJSON' %> (<%= (l.validation.types || []).join(', ') %>) · <%= l.validation.count || 0 %> đối tượng<% if (l.validation.source_crs && l.validation.source_crs !== 'EPSG:4326') { %><div class="src">chuyển từ <%= l.validation.source_crs %></div><% } %></td><td><%= l.source || '—' %></td>
      <td class="src"><%= l.validation.errors.length ? l.validation.errors.join('; ') : (l.description || '') %><br>Tải lên bởi <%= l.uploaded_by %> · <%= fmt.dateTime(l.created_at) %></td><td><span class="badge <%= stB[l.status][0] %>"><%= stB[l.status][1] %></span></td>
      <td><% if (edit) { %><form method="post" action="/quan-tri/du-lieu/<%= l.id %>/trang-thai" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (l.status === 'staging') { %><button class="btn btn-primary btn-sm" name="action" value="published">Duyệt công bố</button><% } %>
        <% if (l.status === 'published') { %><button class="btn btn-outline btn-sm" name="action" value="staging">Gỡ công bố</button><% } %>
        <button class="btn btn-outline btn-sm" name="action" value="delete" onclick="return confirm('Xóa lớp này?')"><%- ic('trash-fill') %></button></form>
        <details class="row-edit"><summary class="src"><%- ic('pencil-fill') %> Sửa</summary><form method="post" action="/quan-tri/du-lieu/<%= l.id %>/sua" class="grid" style="gap:6px;margin-top:6px;min-width:220px"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <input class="input" name="title" value="<%= l.title %>" required><input class="input" name="source" value="<%= l.source || '' %>" placeholder="Nguồn"><textarea class="input" name="description" rows="2" placeholder="Mô tả"><%= l.description || '' %></textarea>
          <input class="input" type="color" name="color" value="<%= (l.style && l.style.color) || '#00bcd4' %>" style="height:34px"><button class="btn btn-primary btn-sm">Lưu</button></form></details><% } %></td></tr><% }) %>
  </tbody></table><% } %></div>
  <div class="card-f">Ranh giới: nguồn <%= manifest && manifest.source_version ? manifest.source_version.DatasetVersion : '' %> (commit <%= manifest ? String(manifest.source_commit).slice(0, 8) : '' %>). Lớp ảnh hệ thống được dựng lại bằng tác vụ ở mục Phân tích.</div>
</section>
<% if (edit) { %>
<form class="card" id="them" style="margin-top:16px" method="post" action="/quan-tri/du-lieu/tai-len" enctype="multipart/form-data">
  <div class="card-h"><h2><%- ic('upload') %> Nhập lớp dữ liệu (GeoJSON, Shapefile, Excel, CSV)</h2></div>
  <div class="card-b grid cols-4">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Tên lớp *</span><input class="input" name="title" required></label>
    <label class="field"><span>Nguồn / cơ quan cung cấp</span><input class="input" name="source"></label>
    <label class="field"><span>Màu hiển thị</span><input class="input" type="color" name="color" value="#00bcd4" style="height:40px"></label>
    <label class="field"><span>Tệp dữ liệu * (≤ 25 MB)</span><input class="input" type="file" name="file" accept=".geojson,.json,.zip,.xlsx,.csv" required></label>
    <label class="field"><span>Hệ toạ độ nguồn</span><select class="input" name="crs"><option value="auto">Tự nhận (theo .prj / độ lớn toạ độ)</option><option value="EPSG:4326">WGS84 kinh độ/vĩ độ (EPSG:4326)</option><option value="VN2000-KT">VN-2000 múi 3° KT 107°45′ (Kon Tum)</option><option value="VN2000-UTM48">VN-2000 UTM múi 48 (6°)</option><option value="EPSG:32648">WGS84 / UTM 48N (EPSG:32648)</option></select></label>
    <label class="field" style="grid-column:span 3"><span>Mô tả, phạm vi, năm dữ liệu</span><textarea class="input" name="description" rows="2"></textarea></label>
    <div style="grid-column:1/-1"><button class="btn btn-primary"><%- ic('upload') %> Tải lên và kiểm tra</button>
      <span class="src" style="margin-left:10px">Shapefile: nén .shp, .shx, .dbf, .prj (và .cpg nếu có) thành một tệp .zip. Excel/CSV: dòng đầu là tiêu đề, có cột <b>lon/lat</b> (kinh độ/vĩ độ) hoặc <b>x/y</b> (mét – chọn hệ toạ độ); các cột còn lại thành thuộc tính. Lớp hợp lệ vào “Chờ duyệt”; duyệt công bố xong tự có trong danh mục lớp.</span></div>
  </div>
</form>
<% } %>
<script>
// nút “Lưu thay đổi” chỉ sáng khi dòng đó có ô bị sửa
document.querySelectorAll('[data-row-form]').forEach((f) => {
  const btn = f.querySelector('button'); const els = document.querySelectorAll(`[form="${f.id}"]`);
  const mark = () => { btn.disabled = false; btn.closest('tr').classList.add('row-dirty'); };
  els.forEach((el) => { el.addEventListener('input', mark); el.addEventListener('change', mark); });
});
</script>
<%- include('_bottom') %>
</body></html>
