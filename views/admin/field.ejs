<%- include('_top') %>
<% const aB = { assigned: 'b-orange', accepted: 'b-blue', in_progress: 'b-blue', submitted: 'b-purple', approved: 'b-green', returned: 'b-red', cancelled: 'b-gray' };
   const rB = { pending: 'b-orange', approved: 'b-green', rejected: 'b-red', pending_review: 'b-orange' };
   const pendingV = verifications.filter(v => v.review_status === 'pending').length, pendingS = surveys.filter(s => s.status === 'pending_review').length;
   const KIND = { hotspot: 'Điểm nóng', candidate: 'Biến động', report: 'Phản ánh', survey: 'Khảo sát' }; %>
<div class="adm-tabs">
  <a href="?tab=nhiem-vu" class="<%= tab === 'nhiem-vu' ? 'on' : '' %>">Nhiệm vụ · <%= assignments.length %></a>
  <a href="?tab=xac-minh" class="<%= tab === 'xac-minh' ? 'on' : '' %>">Kết quả xác minh<%= pendingV ? ` · ${pendingV} chờ duyệt` : '' %></a>
  <a href="?tab=khao-sat" class="<%= tab === 'khao-sat' ? 'on' : '' %>">Khảo sát hiện trạng<%= pendingS ? ` · ${pendingS} chờ duyệt` : '' %></a>
  <a href="?tab=xung-dot" class="<%= tab === 'xung-dot' ? 'on' : '' %>">Xung đột đồng bộ · <%= conflicts.length %></a>
</div>
<% if (!dbOn) { %><div class="note">Chức năng hiện trường MobileGIS cần cơ sở dữ liệu PostgreSQL/PostGIS.</div><% } %>

<% if (tab === 'nhiem-vu') { %>
<div class="grid" style="grid-template-columns:minmax(0,1fr) 380px">
  <section class="card"><div class="card-h"><h2><%- ic('geo-alt-fill') %> Nhiệm vụ hiện trường</h2><span class="more muted" style="font-weight:400">Mới giao → Đã nhận → Đang thực hiện → Đã nộp → Đã duyệt / Trả lại</span></div>
    <div class="card-b table-wrap"><% if (!assignments.length) { %><div class="empty-state">Chưa có nhiệm vụ. Giao nhiệm vụ từ khung bên phải hoặc từ trang Cảnh báo.</div><% } else { %>
    <table class="tbl"><thead><tr><th>Mã</th><th>Loại</th><th>Nội dung</th><th>Địa bàn</th><th>Người thực hiện</th><th>Hạn</th><th>Trạng thái</th><th></th></tr></thead><tbody>
      <% const pg = paginate(assignments, query.trang, 15); pg.items.forEach(a => { const c = communes.find(x => x.code === a.scope_id); %><tr>
        <td><b><%= a.code %></b></td><td><%= KIND[a.kind] %></td><td><%= a.title %><% if (a.lat) { %><div class="src"><a href="/ban-do#<%= a.lon %>,<%= a.lat %>,14" target="_blank"><%= Number(a.lat).toFixed(4) %>, <%= Number(a.lon).toFixed(4) %></a></div><% } %></td>
        <td><%= c ? c.fullName : (a.scope_id || 'Toàn vùng') %></td><td><%= a.assignee_name || a.assignee || 'Cán bộ địa bàn nhận' %></td>
        <td><%= a.due_at ? fmt.dateTime(a.due_at) : '—' %><% if (a.overdue) { %><div class="src" style="color:#c0392b">Quá hạn</div><% } %></td>
        <td><span class="badge <%= aB[a.status] %>"><%= AS[a.status] %></span></td>
        <td><% if (can('tasks.assign') && !['approved','cancelled'].includes(a.status)) { %><form method="post" action="/quan-tri/hien-truong/<%= a.id %>/huy" onsubmit="return confirm('Huỷ nhiệm vụ <%= a.code %>?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline btn-sm">Huỷ</button></form><% } %></td></tr><% }) %>
    </tbody></table><%- include('../partials/pager', { pg }) %><% } %></div></section>

  <section class="card" id="giao"><div class="card-h"><h2><%- ic('plus-lg') %> Giao nhiệm vụ</h2></div>
    <div class="card-b"><% if (!can('tasks.assign')) { %><div class="note info">Giao nhiệm vụ do cán bộ chuyên môn hoặc lãnh đạo thực hiện.</div><% } else { %>
      <form method="post" action="/quan-tri/hien-truong/giao" class="grid" style="gap:10px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Loại nhiệm vụ</span><select class="input" name="kind" id="f-kind">
          <% Object.entries(KIND).forEach(([k, l]) => { %><option value="<%= k %>" <%= prefill.kind === k ? 'selected' : '' %>><%= l === 'Khảo sát' ? 'Khảo sát / cập nhật hiện trạng' : 'Xác minh ' + l.toLowerCase() %></option><% }) %></select></label>
        <label class="field"><span>Mã đối tượng (điểm nóng, biến động, mã phản ánh)</span><input class="input" name="ref_id" value="<%= prefill.ref %>" placeholder="VD: PA-2026-0001"></label>
        <label class="field"><span>Tiêu đề (để trống = tự sinh)</span><input class="input" name="title" maxlength="300"></label>
        <label class="field"><span>Hướng dẫn cho cán bộ</span><textarea class="input" name="instructions" rows="3" placeholder="Nội dung cần kiểm tra, bằng chứng cần thu thập…"></textarea></label>
        <label class="field"><span>Giao cho</span><select class="input" name="assignee_id"><option value="">Cán bộ phụ trách địa bàn tự nhận</option>
          <% specialists.forEach(u => { const c = communes.find(x => x.code === u.scope); %><option value="<%= u.id %>"><%= u.name || u.username %> (<%= c ? c.fullName : 'toàn vùng' %>)</option><% }) %></select></label>
        <label class="field"><span>Địa bàn (khảo sát không gắn đối tượng)</span><select class="input" name="scope_id"><option value="">Theo vị trí đối tượng</option><% communes.forEach(c => { %><option value="<%= c.code %>"><%= c.fullName %></option><% }) %></select></label>
        <div class="grid cols-2" style="gap:8px"><label class="field"><span>Vĩ độ</span><input class="input" name="lat" inputmode="decimal" placeholder="14.6"></label><label class="field"><span>Kinh độ</span><input class="input" name="lon" inputmode="decimal" placeholder="108.0"></label></div>
        <label class="field"><span>Hạn hoàn thành</span><input class="input" type="datetime-local" name="due_at"></label>
        <button class="btn btn-primary"><%- ic('send-fill') %> Giao nhiệm vụ</button>
        <p class="src">Cán bộ nhận nhiệm vụ trên ứng dụng MobileGIS (mục Nhiệm vụ), đến hiện trường thu GPS, ảnh và nộp kết quả. Cán bộ được giới hạn theo địa bàn chỉ thấy nhiệm vụ trong xã mình.</p>
      </form><% } %></div></section>
</div>
<% } %>

<% if (tab === 'xac-minh') { %>
<section class="card"><div class="card-h"><h2><%- ic('check-circle-fill') %> Kết quả xác minh từ MobileGIS</h2><span class="more muted" style="font-weight:400">Bản ghi xác minh là lịch sử bất biến; duyệt/trả lại tạo bản ghi duyệt riêng</span></div>
  <div class="card-b table-wrap"><% if (!verifications.length) { %><div class="empty-state">Chưa có kết quả xác minh.</div><% } else { %>
  <table class="tbl"><thead><tr><th>Mã</th><th>Đối tượng</th><th>Kết luận</th><th>Mức độ / DT cháy</th><th>Kiến nghị</th><th>Người xác minh</th><th>GPS</th><th>Trạng thái</th><th>Duyệt</th></tr></thead><tbody>
    <% const pg = paginate(verifications, query.trang, 15); pg.items.forEach(v => { %><tr>
      <td><b><%= v.code %></b><div class="src"><a href="/quan-tri/api/hien-truong/xac-minh/<%= v.id %>" target="_blank">Bằng chứng</a></div></td>
      <td><%= KIND[v.alert_kind] %><div class="src" style="word-break:break-all"><%= v.alert_id %></div></td>
      <td><b><%= v.verdict_label %></b><div class="src"><%= (v.evidence && v.evidence.description) || '' %></div></td>
      <td><%= v.severity || '—' %><%= v.burned_area_ha ? ` · ${v.burned_area_ha} ha` : '' %></td><td><%= v.recommendation || '—' %></td>
      <td><%= v.verifier %><div class="src"><%= fmt.dateTime(v.verified_at) %></div></td>
      <td><%= v.lat ? `${Number(v.lat).toFixed(5)}, ${Number(v.lon).toFixed(5)}` : '—' %><div class="src"><%= v.gps_accuracy ? `±${Math.round(v.gps_accuracy)} m` : '' %> <%= v.evidence && v.evidence.location_source !== 'gps' ? '(chọn tay)' : '' %></div></td>
      <td><span class="badge <%= rB[v.review_status] %>"><%= { pending: 'Chờ duyệt', approved: 'Đã duyệt', rejected: 'Trả lại' }[v.review_status] %></span></td>
      <td><% if (v.review_status === 'pending' && can('field.review')) { %><form method="post" action="/quan-tri/hien-truong/xac-minh/<%= v.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="input" name="note" placeholder="Ý kiến duyệt"><button class="btn btn-primary btn-sm" name="decision" value="approved">Duyệt</button><button class="btn btn-outline btn-sm" name="decision" value="rejected">Trả lại</button></form><% } else { %>—<% } %></td></tr><% }) %>
  </tbody></table><%- include('../partials/pager', { pg }) %><% } %>
  <p class="src">Duyệt “Có cháy rừng” chuyển điểm nóng sang “Xác nhận cháy”; duyệt biến động “Xác nhận mất rừng / Rụng lá theo mùa” cập nhật trạng thái tương ứng. Không tự duyệt kết quả của chính mình.</p></div></section>
<% } %>

<% if (tab === 'khao-sat') { %>
<section class="card"><div class="card-h"><h2><%- ic('tree-fill') %> Khảo sát, cập nhật hiện trạng rừng</h2></div>
  <div class="card-b table-wrap"><% if (!surveys.length) { %><div class="empty-state">Chưa có khảo sát.</div><% } else { %>
  <table class="tbl"><thead><tr><th>Mã</th><th>Hình học</th><th>Loại rừng</th><th>Mùa / tán lá</th><th>Nguyên nhân biến động</th><th>Ghi chú</th><th>Người khảo sát</th><th>Trạng thái</th><th>Duyệt</th></tr></thead><tbody>
    <% const pg = paginate(surveys, query.trang, 15); pg.items.forEach(s => { %><tr>
      <td><b><%= s.code %></b></td><td><%= { point: 'Điểm', line: 'Đường', polygon: 'Vùng' }[s.geom_type] %><div class="src"><%= s.area_ha ? `${Number(s.area_ha).toFixed(2)} ha` : s.length_m ? `${Math.round(s.length_m)} m` : '' %> <%= s.gps_accuracy ? `· ±${Math.round(s.gps_accuracy)} m` : '' %></div></td>
      <td><%= s.forest_type_label || '—' %><% if (s.is_dipterocarp) { %> <span class="badge b-yellow">Rừng khộp</span><% } %></td>
      <td><%= s.season === 'dry' ? 'Mùa khô' : 'Mùa mưa' %> / <%= { full: 'đủ lá', partial: 'rụng một phần', leafless: 'rụng hết lá', unknown: 'không rõ' }[s.leaf_state] || '—' %></td>
      <td><%= s.change_cause || '—' %></td><td style="max-width:260px"><span class="src"><%= s.notes || '' %></span></td>
      <td><%= s.surveyor %><div class="src"><%= fmt.dateTime(s.observed_at) %></div></td>
      <td><span class="badge <%= rB[s.status] %>"><%= { pending_review: 'Chờ duyệt', approved: 'Đã duyệt', rejected: 'Từ chối' }[s.status] %></span></td>
      <td><% if (s.status === 'pending_review' && can('field.review')) { %><form method="post" action="/quan-tri/hien-truong/khao-sat/<%= s.id %>" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="input" name="note" placeholder="Ý kiến"><button class="btn btn-primary btn-sm" name="decision" value="approved">Chấp thuận</button><button class="btn btn-outline btn-sm" name="decision" value="rejected">Từ chối</button></form><% } else { %><%= s.review_note || '—' %><% } %></td></tr><% }) %>
  </tbody></table><%- include('../partials/pager', { pg }) %><% } %>
  <p class="src">Rừng khộp khảo sát mùa khô: hệ thống tự ghi chú “chưa đủ căn cứ kết luận mất rừng” nếu chỉ dựa vào tán lá/NDVI thấp. Mỗi lần chỉnh sửa lưu lịch sử phiên bản.</p></div></section>
<% } %>

<% if (tab === 'xung-dot') { %>
<section class="card"><div class="card-h"><h2><%- ic('arrow-repeat') %> Xung đột đồng bộ ngoại tuyến chưa xử lý</h2></div>
  <div class="card-b table-wrap"><% if (!conflicts.length) { %><div class="empty-state"><%- ic('check-circle-fill') %>Không có xung đột.</div><% } else { %>
  <table class="tbl" data-page-size="20"><thead><tr><th>Thời gian</th><th>Người dùng</th><th>Bản ghi</th><th>Phiên bản gốc → máy chủ</th><th>Thông báo</th></tr></thead><tbody>
    <% conflicts.forEach(c => { %><tr><td><%= fmt.dateTime(c.created_at) %></td><td><%= c.username %></td><td><%= c.entity %> · <%= c.operation %></td><td><%= c.base_version %> → <%= c.server_version %></td><td><%= c.message %></td></tr><% }) %>
  </tbody></table><% } %>
  <p class="src">Hệ thống không ghi đè âm thầm: người dùng tự chọn giữ bản trên máy chủ hoặc áp dụng thay đổi của mình trong ứng dụng (mục Đồng bộ).</p></div></section>
<% } %>
<%- include('_bottom') %>
</body></html>
