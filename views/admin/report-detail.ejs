<%- include('_top', { needsMap: true }) %>
<% const tone = { info: 'b-blue', warn: 'b-orange', danger: 'b-red', ok: 'b-green', muted: 'b-gray' }; %>
<div class="grid" style="grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)">
  <section class="card">
    <div class="card-h"><h2><img src="/assets/markers/<%= x.marker %>.svg" width="22" alt=""> <%= x.code %> · <%= x.typeLabel %></h2><span class="badge <%= tone[x.statusTone] %>" style="margin-left:auto"><%= x.statusLabel %></span><span class="badge <%= x.reviewed_at ? 'b-green' : 'b-gray' %>" style="margin-left:6px"><%= x.reviewed_at ? 'Đã kiểm tra' : 'Chưa kiểm tra' %></span></div>
    <div class="card-b">
      <table class="kv"><tr><td>Thời gian gửi</td><td><%= fmt.dateTime(x.created_at) %></td></tr><tr><td>Thời điểm phát hiện</td><td><%= x.observed_at ? x.observed_at.replace('T', ' ') : '—' %></td></tr>
        <tr><td>Địa bàn</td><td><%= x.commune_name || 'Ngoài ranh 40 xã' %></td></tr><tr><td>Tọa độ</td><td><%= x.lat %>, <%= x.lon %> <% if (x.lat) { %>· <a href="/ban-do#<%= x.lon %>,<%= x.lat %>,14" target="_blank">mở bản đồ</a><% } %></td></tr>
        <tr><td>Mô tả địa điểm</td><td><%= x.location_text || '—' %></td></tr><tr><td>Nội dung</td><td><%= x.description %></td></tr>
        <tr><td>Nguồn gửi</td><td><%= x.source === 'mobile' ? 'Ứng dụng MobileGIS' + (x.created_by ? ' (tài khoản người dân)' : ' (khách)') : 'Cổng thông tin web' %><% if (x.gps_accuracy) { %> · GPS ±<%= Math.round(x.gps_accuracy) %> m<% } %><% if (x.location_source && x.location_source !== 'gps') { %> · vị trí chọn trên bản đồ<% } %></td></tr>
        <tr><td>Người gửi (bảo mật)</td><td><%= x.reporter.name || 'Ẩn danh' %> · <%= x.reporter.phone || '—' %> · <%= x.reporter.email || '—' %></td></tr></table>
      <% if (x.photos.length) { %><div class="photo-strip" style="margin-top:12px"><% x.photos.forEach(p => { %><a href="/phan-anh/anh/<%= p %>" target="_blank"><img src="/phan-anh/anh/<%= p %>" alt=""></a><% }) %></div><% } %>
      <% if (x.videos && x.videos.length) { %><div style="margin-top:10px"><% x.videos.forEach(v => { %><video src="/quan-tri/hien-truong/tep/<%= v %>" controls preload="metadata" style="max-width:100%;max-height:260px;border-radius:8px;margin-right:8px"></video><% }) %></div><% } %>
      <div class="map-shell" style="height:280px;margin-top:12px"><div id="map" class="map"></div></div>
    </div>
  </section>
  <div class="grid" style="align-content:start">
    <section class="card"><div class="card-h"><h2><%- ic('check-circle-fill') %> Kiểm tra hồ sơ</h2></div>
      <div class="card-b">
        <% if (x.reviewed_at) { %><p>Đã kiểm tra bởi <b><%= x.reviewed_by %></b> lúc <%= fmt.dateTime(x.reviewed_at) %>.</p><% } else { %><p class="muted">Hồ sơ chưa được kiểm tra.</p><% } %>
        <% if (can('reports.manage')) { %><form method="post" action="/quan-tri/phan-anh/<%= x.id %>/kiem-tra" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="reviewed" value="<%= x.reviewed_at ? '0' : '1' %>">
          <button class="btn <%= x.reviewed_at ? 'btn-outline' : 'btn-primary' %> btn-sm"><%- ic('check-circle-fill') %> <%= x.reviewed_at ? 'Bỏ đánh dấu đã kiểm tra' : 'Đánh dấu đã kiểm tra' %></button></form><% } %>
      </div></section>
    <% if (x.type === 'chay-rung') { %>
    <section class="card"><div class="card-h"><h2><%- ic('fire') %> Điểm cháy trong cảnh báo</h2></div>
      <div class="card-b">
        <% if (x.fire_point) { %>
          <p>Đã gắn với điểm cháy <b><%= x.fire_point %></b><% if (fp) { %> – trạng thái <b><%= fp.statusLabel %></b><% } %>.</p>
          <a class="btn btn-outline btn-sm" href="/quan-tri/canh-bao?tab=diem-nong&nguon=tay"><%- ic('fire') %> Xác minh / cập nhật trong Quản lý cảnh báo</a>
        <% } else if (can('alerts.manual') && x.lat !== null && x.lat !== undefined) { %>
          <p class="muted" style="margin-bottom:8px">Đưa phản ánh này vào danh sách điểm cháy (chung với điểm nóng FIRMS) để xác minh, theo dõi trên bản đồ và gửi thông báo khi xác nhận.</p>
          <form method="post" action="/quan-tri/phan-anh/<%= x.id %>/diem-chay"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="field"><span>Ghi chú</span><input class="input" name="note" placeholder="Ví dụ: đã gọi xác nhận với tổ chống cháy xã"></label>
            <button class="btn btn-outline btn-sm" name="confirm" value="0"><%- ic('plus-lg') %> Tạo điểm cháy – chờ xác minh</button>
            <% if (can('alerts.verify')) { %><button class="btn btn-primary btn-sm" name="confirm" value="1" onclick="return confirm('Xác nhận cháy sẽ gửi thông báo tới người dân trong xã qua MobileGIS. Tiếp tục?')"><%- ic('check-circle-fill') %> Xác nhận cháy và thông báo</button><% } %>
          </form>
        <% } else { %><p class="muted">Phản ánh chưa có toạ độ hoặc vai trò của bạn không nhập điểm cháy.</p><% } %>
      </div></section>
    <% } %>
    <% if (can('reports.manage')) { %>
    <form class="card" method="post">
      <div class="card-h"><h2><%- ic('clipboard-check-fill') %> Xử lý hồ sơ</h2></div>
      <div class="card-b">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Trạng thái</span><select class="input" name="status"><% Object.entries(statuses).forEach(([k, s]) => { %><option value="<%= k %>" <%= x.status === k ? 'selected' : '' %>><%= s.label %></option><% }) %></select></label>
        <label class="field"><span>Phân công cán bộ</span><select class="input" name="assigned_to"><option value="">—</option><% users.forEach(u => { %><option <%= x.assigned_to === u.username ? 'selected' : '' %>><%= u.username %></option><% }) %></select></label>
        <label class="field"><span>Ghi chú xử lý</span><textarea class="input" name="note" rows="2"></textarea></label>
        <label class="check"><input type="checkbox" name="note_public"> Hiển thị ghi chú này cho người gửi khi tra cứu</label>
        <label class="field"><span>Phản hồi kết quả (công khai)</span><textarea class="input" name="response" rows="2"><%= x.response || '' %></textarea></label>
        <label class="check"><input type="checkbox" name="public" <%= x.public ? 'checked' : '' %>> Công khai trong danh sách phản ánh (không kèm thông tin người gửi, vị trí làm tròn)</label>
        <label class="check"><input type="checkbox" name="public_photos" <%= x.public_photos ? 'checked' : '' %>> Cho phép công khai ảnh</label>
        <button class="btn btn-primary" style="margin-top:10px">Lưu cập nhật</button>
      </div>
    </form>
    <% } %>
    <section class="card"><div class="card-h"><h2><%- ic('clock-history') %> Lịch sử xử lý</h2></div>
      <div class="card-b"><ul class="timeline"><% x.timeline.forEach(t => { %><li class="done"><b><%= statuses[t.status] ? statuses[t.status].label : t.status %></b><time><%= fmt.dateTime(t.at) %> · <%= t.by %><%= t.note ? ' · ' + t.note : '' %><%= t.public_note ? ' (công khai)' : '' %></time></li><% }) %></ul></div></section>
  </div>
</div>
<%- include('_bottom') %>
<%- include('../partials/mapjs') %>
<script>
(function () { const ll = <%- JSON.stringify(x.lat !== null ? [x.lon, x.lat] : null) %>; if (!ll) return;
  const v = KT.createMap('map', { basemap: 'satellite', bounds: [[ll[0] - 0.03, ll[1] - 0.03], [ll[0] + 0.03, ll[1] + 0.03]] });
  if (!v) return; v.define('communes', KT.layers.communes(v)); new mapboxgl.Marker({ color: '#e0322d' }).setLngLat(ll).addTo(v.map); })();
</script>
</body></html>
