<%- include('_top') %>
<% const st = { running: ['b-orange', 'Đang chạy'], succeeded: ['b-green', 'Hoàn thành'], failed: ['b-red', 'Lỗi'] }; const fv = fcg ? fcg.forecast.validation : null; const vd = fd ? fd.validation : null; %>
<% const per = (h) => h >= 2160 ? 'quý' : h >= 720 ? 'tháng' : h >= 168 ? (h / 168) + ' tuần' : h >= 24 ? (h / 24) + ' ngày' : h + ' giờ'; const rel = (t) => { if (!t) return '—'; const m = Math.round((new Date(t) - Date.now()) / 60e3); return m <= 0 ? 'đến hạn' : m < 60 ? `sau ${m} phút` : m < 2880 ? `sau ${Math.round(m / 60)} giờ` : `sau ${Math.round(m / 1440)} ngày`; }; %>
<section class="card" style="margin-bottom:16px">
  <div class="card-h"><h2><%- ic('calendar3') %> Lịch chạy tự động</h2>
    <span class="badge <%= schedulerOn ? 'b-green' : 'b-gray' %>"><%= schedulerOn ? 'Bộ lập lịch đang hoạt động' : 'Bộ lập lịch tắt (ENABLE_DATA_JOBS=false)' %></span></div>
  <div class="card-b">
    <form method="post" action="/quan-tri/phan-tich/lich">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="table-wrap"><table class="tbl">
        <thead><tr><th style="width:34%">Tác vụ</th><th>Tự động</th><th>Chu kỳ</th><th>Lần chạy gần nhất</th><th>Lần tới</th><th></th></tr></thead><tbody>
        <% Object.entries(defs).forEach(([k, d]) => { const p = plan[k]; const l = p.last; %>
          <tr>
            <td><b><%= d.title %></b><div class="src"><%= d.steps.map(s => s.script + (s.optional ? '*' : '')).join(' → ') %></div><div class="src"><%= d.note %></div></td>
            <td><label class="switch-l"><input type="checkbox" name="en_<%= k %>" <%= p.enabled ? 'checked' : '' %> <%= !can('jobs.run') ? 'disabled' : '' %>> Bật</label></td>
            <td><select name="every_<%= k %>" <%= !can('jobs.run') ? 'disabled' : '' %>><option value="0" <%= !p.every ? 'selected' : '' %>>Chỉ chạy tay</option><% (d.periods || periods.filter(h => h <= 720)).forEach(h => { %><option value="<%= h %>" <%= p.every === h ? 'selected' : '' %>>Mỗi <%= per(h) %></option><% }) %></select><% if (d.calendar) { %><div class="src">ngày <%= d.calendar.day %>, <%= String(d.calendar.hour).padStart(2, '0') %>:00<%= p.every >= 2160 ? ' tháng 1, 4, 7, 10' : ' hằng tháng' %></div><% } %></td>
            <td><% if (l) { %><span class="badge <%= st[l.status][0] %>"><%= st[l.status][1] %></span> <%= fmt.dateTime(l.started_at) %><div class="src"><%= l.trigger === 'schedule' ? 'tự động' : (l.by || '') %><%= l.duration_s ? ' · ' + Math.round(l.duration_s / 60) + ' phút' : '' %><%= l.warnings && l.warnings.length ? ' · thu thập lỗi: ' + l.warnings.join(', ') : '' %></div><% if (p.fails) { %><div class="src" style="color:#c0392b">Lỗi liên tiếp <%= p.fails %> lần<%= p.fails <= 3 ? ' – tự thử lại sau 30 phút' : ' – chờ chu kỳ kế tiếp' %> · <a href="?job=<%= l.id %>#job-log">xem nhật ký lỗi</a></div><% } %><% } else { %>Chưa chạy<% } %></td>
            <td><%= p.enabled ? (p.next ? fmt.dateTime(p.next) : 'đang chạy') : '—' %><div class="src"><%= p.enabled && p.next ? rel(p.next) : '' %></div></td>
            <td><button class="btn btn-outline btn-sm" formaction="/quan-tri/phan-tich/chay" name="key" value="<%= k %>" <%= running || !can('jobs.run') ? 'disabled' : '' %>><%- ic('arrow-repeat') %> Chạy ngay</button></td>
          </tr>
        <% }) %>
          <tr><td><b>Điểm nóng cháy NASA FIRMS (Area API)</b><div class="src">Dịch vụ nền của máy chủ, tiết kiệm lượt gọi (kiểm tra hạn mức trước khi tải)</div></td><td><%= firmsSt.enabled ? 'Luôn bật' : 'Chưa có MAP KEY' %></td><td>Mỗi <%= firmsSt.interval_minutes %> phút</td><td><%= firmsSt.collected_at ? fmt.dateTime(firmsSt.collected_at) : '—' %></td><td><%= firmsSt.backoff_until ? 'tạm hoãn đến ' + fmt.dateTime(firmsSt.backoff_until) : '' %></td><td></td></tr>
        </tbody></table></div>
      <div style="display:flex;gap:10px;align-items:center;margin-top:10px">
        <% if (can('jobs.run')) { %><button class="btn btn-primary btn-sm"><%- ic('check-lg') %> Lưu lịch</button><% } %>
        <span class="src">Chỉ một tác vụ chạy tại một thời điểm; tác vụ đến hạn được xếp lượt. Bước có dấu * là thu thập dữ liệu từ nguồn ngoài (Open-Meteo, Google Earth Engine): nếu lỗi mạng hoặc hạn mức, tác vụ vẫn tính tiếp với dữ liệu đã có và ghi cảnh báo. Kết quả dự báo vẫn cần cán bộ duyệt trước khi phát hành cảnh báo chính thức.</span>
      </div>
    </form>
  </div>
</section>
<section class="card" id="bien-dong" style="margin-bottom:16px">
  <div class="card-h"><h2><%- ic('graph-up-arrow') %> Phân tích biến động rừng (Sentinel-2)</h2></div>
  <div class="card-b">
    <p class="src" style="margin-bottom:10px">Thuật toán chung cho cả hai cơ chế: ảnh Sentinel-2 median tháng 100 m (lọc mây) của kỳ phân tích so với kỳ đối chứng; ô nghi vấn khi NDVI giảm vượt ngưỡng, NBR giảm vượt ngưỡng, lặp lại đủ số tháng, nằm trong rừng còn đến 2024 (Hansen); gộp vùng đạt diện tích tối thiểu. Kết quả là <b>nghi vấn – chưa xác minh</b>, chỉ hiện ra bản đồ công khai khi được công bố. Ảnh có sẵn: <%= monthsAvail.length ? monthsAvail[0].slice(5) + '/' + monthsAvail[0].slice(0, 4) + ' – ' + monthsAvail[monthsAvail.length - 1].slice(5) + '/' + monthsAvail[monthsAvail.length - 1].slice(0, 4) + ' (' + monthsAvail.length + ' tháng)' : 'chưa có' %>.</p>
    <div class="grid" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px">
      <!-- tự động -->
      <div class="card" style="box-shadow:none;border:1px solid var(--line)">
        <div class="card-h"><h3 style="font-size:15px;margin:0"><%- ic('calendar3') %> 1. Tự động theo lịch</h3>
          <span class="badge <%= autoState.mode === 'auto' ? 'b-green' : 'b-blue' %>" style="margin-left:auto"><%= autoState.mode === 'auto' ? 'Tự công bố' : 'Chờ duyệt' %></span></div>
        <div class="card-b">
          <p class="src">Tác vụ “Ảnh Sentinel-2 tháng mới → phân tích biến động” (bảng lịch ở trên) tự tải ảnh và phân tích các kỳ theo mùa (01–04, 05–06, 07–09, 10–12) có ≥ 2 tháng ảnh trong 12 tháng gần nhất, so với cùng kỳ 1–2 năm trước.</p>
          <table class="kv" style="margin:8px 0">
            <tr><td>Lần phân tích mới nhất</td><td><%= autoDraft.generated_at ? fmt.dateTime(autoDraft.generated_at) : '—' %> <% if (autoPending) { %><span class="badge b-orange">chưa công bố</span><% } else if (autoDraft.generated_at) { %><span class="badge b-green">đã công bố</span><% } %></td></tr>
            <tr><td>Các kỳ</td><td><%= (autoDraft.windows || []).map(w => w.window.split(' ')[0].replace(/^(\d{4})-(\d{2})\.\.(\d{2})$/, '$2–$3/$1') + ': ' + w.candidates + ' vùng' + (w.low_confidence ? ' (đối chứng 1 năm)' : '')).join(' · ') || '—' %></td></tr>
            <tr><td>Đang công bố</td><td><%= autoState.approved_at ? fmt.dateTime(autoState.approved_generated_at) + ' · duyệt bởi ' + autoState.approved_by + ' lúc ' + fmt.dateTime(autoState.approved_at) : 'chưa có' %></td></tr>
          </table>
          <% if (can('alerts.approve')) { %>
          <form method="post" action="/quan-tri/phan-tich/tu-dong/che-do" class="inline-form" style="margin-bottom:8px"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <select class="input" name="mode"><option value="review" <%= autoState.mode !== 'auto' ? 'selected' : '' %>>Chờ duyệt trước khi công bố</option><option value="auto" <%= autoState.mode === 'auto' ? 'selected' : '' %>>Tự công bố sau mỗi lần chạy</option></select>
            <button class="btn btn-outline btn-sm">Lưu chế độ</button></form>
          <% if (autoPending) { %><form method="post" action="/quan-tri/phan-tich/tu-dong/cong-bo"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <input class="input" name="note" placeholder="Ghi chú công bố (tuỳ chọn)" style="margin-bottom:6px">
            <div style="display:flex;gap:8px"><a class="btn btn-outline btn-sm" href="/quan-tri/canh-bao?tab=bien-dong">Xem vùng nghi vấn mới</a><button class="btn btn-primary btn-sm"><%- ic('check-lg') %> Công bố kết quả mới</button></div></form><% } %>
          <% } %>
        </div>
      </div>
      <!-- thủ công -->
      <form class="card" style="box-shadow:none;border:1px solid var(--line)" method="post" action="/quan-tri/phan-tich/bien-dong">
        <div class="card-h"><h3 style="font-size:15px;margin:0"><%- ic('funnel-fill') %> 2. Chạy thủ công theo thời gian tuỳ chọn</h3></div>
        <div class="card-b">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% const f = form || {}; %>
          <div class="grid" style="grid-template-columns:1fr 1fr;gap:8px">
            <label class="field"><span>Kỳ phân tích – từ tháng *</span><input class="input" type="month" name="from" required min="2025-01" max="<%= monthsAvail[monthsAvail.length - 1] || '' %>" value="<%= f.from || '' %>"></label>
            <label class="field"><span>đến tháng *</span><input class="input" type="month" name="to" required min="2025-01" max="<%= monthsAvail[monthsAvail.length - 1] || '' %>" value="<%= f.to || '' %>"></label>
          </div>
          <p class="src" style="margin:-2px 0 8px">Hệ thống tự xác định: <b>kỳ đối chứng</b> là cùng các tháng của 1–2 năm trước có ảnh; <b>ngưỡng phát hiện</b> tự thích nghi theo dữ liệu của kỳ (chặt hơn khi ảnh nhiều nhiễu do mây, mùa khô). Các giá trị đã dùng hiển thị ở trang kết quả.</p>
          <label class="field"><span>Ghi chú</span><input class="input" name="note" value="<%= f.note || '' %>" placeholder="Mục đích phân tích, khu vực quan tâm…"></label>
          <% if (can('alerts.approve')) { %><label class="check"><input type="checkbox" name="publish_now"> Công bố ngay khi chạy xong</label><% } else { %><p class="src">Kết quả cần cán bộ chuyên môn/lãnh đạo duyệt trước khi công bố.</p><% } %>
          <button class="btn btn-primary" style="margin-top:8px" <%= !can('jobs.run') ? 'disabled' : '' %>><%- ic('arrow-repeat') %> Chạy phân tích</button>
        </div>
      </form>
    </div>
    <!-- các kỳ đã chạy -->
    <h3 style="font-size:15px;margin:16px 0 6px">Các kỳ phân tích theo yêu cầu</h3>
    <% const rs = { queued: ['b-gray', 'Chờ chạy'], running: ['b-orange', 'Đang chạy'], succeeded: ['b-green', 'Hoàn thành'], failed: ['b-red', 'Lỗi'] }; %>
    <div class="table-wrap"><% if (!runs.length) { %><div class="empty-state">Chưa có kỳ phân tích nào.</div><% } else { %>
    <table class="tbl" data-page-size="10"><thead><tr><th>Mã</th><th>Kỳ phân tích</th><th>Người chạy</th><th>Trạng thái</th><th class="num">Vùng nghi vấn</th><th class="num">Diện tích (ha)</th><th>Công bố</th><th></th></tr></thead><tbody>
      <% runs.forEach(r => { %><tr><td><%= r.code %></td><td><%= r.title %><% if (r.summary && r.summary.months_with_images < r.summary.requested_months) { %><div class="src">ảnh có <%= r.summary.months_with_images %>/<%= r.summary.requested_months %> tháng</div><% } %></td><td><%= r.created_by %><div class="src"><%= fmt.dateTime(r.created_at) %></div></td>
        <td><span class="badge <%= rs[r.status][0] %>"><%= rs[r.status][1] %></span></td><td class="num"><%= r.summary ? fmt.num(r.summary.candidates) : '—' %></td><td class="num"><%= r.summary ? fmt.num(r.summary.area_ha) : '—' %></td>
        <td><%= r.published ? 'Đã công bố' : (r.status === 'succeeded' ? 'Chưa' : '—') %></td><td><a class="btn btn-outline btn-sm" href="/quan-tri/phan-tich/bien-dong/<%= r.id %>">Xem</a></td></tr><% }) %>
    </tbody></table><% } %></div>
  </div>
</section>
<div class="grid" style="grid-template-columns:minmax(0,1fr)">
  <section class="card">
    <div class="card-h"><h2><%- ic('check-circle-fill') %> Kết quả mô hình hiện hành</h2></div>
    <div class="card-b">
      <h3 style="font-size:14px">Dự báo nguy cơ mất rừng (Random Forest, 100 m)</h3>
      <% if (fv) { %><table class="kv"><tr><td>AUC kiểm định <%= D.validationLabel %></td><td><b><%= fmt.num(fv.auc, 3) %></b></td></tr><tr><td>Brier hiệu chỉnh</td><td><%= fv.brier_calibrated %></td></tr><tr><td>Bắt được ở 10% nguy cơ cao nhất</td><td><%= fmt.num(fv.top10pct_capture * 100, 1) %>%</td></tr><tr><td>Tính lúc</td><td><%= fmt.dateTime(fcg.generated_at_utc) %></td></tr></table><% } %>
      <h3 style="font-size:14px;margin-top:12px">Chỉ số nguy cơ cháy (Nesterov P, FWI)</h3>
      <% if (vd) { %><table class="kv"><tr><td>AUC P / FWI</td><td><b><%= fmt.num(vd.auc_nesterov_p, 3) %></b> / <b><%= fmt.num(vd.auc_fwi, 3) %></b></td></tr><tr><td>Ngày-xã kiểm định</td><td><%= fmt.num(vd.commune_days) %> (<%= fmt.num(vd.commune_days_with_hotspot) %> có điểm nóng)</td></tr><tr><td>Tính lúc</td><td><%= fmt.dateTime(fd.generated_at_utc) %></td></tr></table><% } %>
      <p class="src">Tham chiếu kiểm định là dữ liệu vệ tinh (Hansen, FIRMS), chưa phải hồ sơ đã xác minh. Kết quả xác minh nhập ở mục Cảnh báo sẽ là nhãn để hiệu chỉnh mô hình về sau.</p>
    </div>
  </section>
</div>
<% if (job) { %>
<section class="card" style="margin-top:16px"><div class="card-h"><h2><%- ic('hourglass-split') %> <%= job.title %></h2><span class="badge <%= st[job.status][0] %>" id="job-st"><%= st[job.status][1] %></span></div>
  <div class="card-b"><pre class="log-pre" id="job-log"><%= (job.log || []).join('\n') %></pre></div></section>
<script>
(function () { const id = <%- JSON.stringify(job.id) %>; const st = { running: 'Đang chạy', succeeded: 'Hoàn thành', failed: 'Lỗi' };
  const tick = async () => { const j = await fetch('/quan-tri/api/jobs/' + id).then((r) => r.json()); document.getElementById('job-log').textContent = (j.log || []).join('\n'); document.getElementById('job-st').textContent = st[j.status]; if (j.status === 'running') setTimeout(tick, 2500); };
  if (<%- JSON.stringify(job.status) %> === 'running') setTimeout(tick, 1500); })();
</script>
<% } %>
<section class="card" style="margin-top:16px"><div class="card-h"><h2><%- ic('clock-history') %> Lịch sử chạy</h2></div>
  <div class="card-b table-wrap"><% if (!jobs.length) { %><div class="empty-state">Chưa có lần chạy nào.</div><% } else { %><table class="tbl" data-page-size="10"><thead><tr><th>Tác vụ</th><th>Người chạy</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    <% const pg = { items: jobs, offset: 0 }; pg.items.forEach(j => { %><tr><td><%= j.title %></td><td><%= j.by %></td><td><%= fmt.dateTime(j.started_at) %></td><td><%= j.finished_at ? fmt.dateTime(j.finished_at) : '—' %></td><td><span class="badge <%= st[j.status][0] %>"><%= st[j.status][1] %></span></td><td><a href="?job=<%= j.id %>">Nhật ký</a></td></tr><% }) %></tbody></table><% } %></div></section>
<%- include('_bottom') %>
</body></html>
