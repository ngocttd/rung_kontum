<span class="password-control">
  <input class="input" id="<%= id %>" name="<%= name %>" type="password" autocomplete="<%= autocomplete %>" required <%= typeof minlength !== 'undefined' ? 'minlength=' + minlength : '' %>>
  <button class="password-toggle" type="button" data-password-toggle aria-controls="<%= id %>" aria-label="Hiện mật khẩu" aria-pressed="false"><%- ic('eye-fill') %></button>
</span>
