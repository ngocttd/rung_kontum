# ============================================================================
#  WebGIS Kon Tum – cấu hình máy chủ (sao chép thành .env rồi điền giá trị)
#  KHÔNG commit .env, KHÔNG gửi khoá qua kênh không an toàn.
# ============================================================================

# --- Máy chủ web ---
NODE_ENV=production
PORT=3000
# 127.0.0.1 khi chạy sau reverse proxy (IIS/Caddy/Nginx); 0.0.0.0 nếu truy cập trực tiếp cổng 3000
HOST=127.0.0.1
# false CHỈ khi tạm chạy HTTP (chưa có tên miền/HTTPS); có HTTPS thì bỏ dòng này
# COOKIE_SECURE=false
# Bí mật phiên đăng nhập web (chuỗi ngẫu nhiên dài; để trống sẽ tự sinh và lưu storage/.session-secret)
SESSION_SECRET=
# Thư mục lưu phiên đăng nhập (mặc định thư mục tạm của hệ điều hành)
# SESSION_DIR=C:\webgis-kontum\storage\sessions

# --- PostgreSQL / PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rung_kontum
# Tài khoản quản trị (dùng cho npm run db:setup, sao lưu, khôi phục)
DB_USER=postgres
DB_PASSWORD=
# Tài khoản ứng dụng quyền tối thiểu – để trống, "npm run db:setup" tự tạo và ghi vào đây
DB_APP_USER=app_kontum
DB_APP_PASSWORD=

# --- Python cho các luồng phân tích (đường dẫn python.exe của venv) ---
PYTHON=C:\webgis-kontum\.venv\Scripts\python.exe
# Lịch chạy tự động luồng phân tích (mặc định bật)
# ENABLE_DATA_JOBS=true

# --- Dịch vụ ngoài ---
# Mapbox public token (pk.…) – BẮT BUỘC để hiển thị bản đồ; giới hạn URL trong tài khoản Mapbox
MAPBOX_TOKEN=
MAPBOX_TRAFFIC_TILESET=
# Thời tiết hiện tại (OpenWeather) – tuỳ chọn
OPENWEATHER_KEY=
WEATHER_REFRESH_MINUTES=30
# Điểm nóng cháy NASA FIRMS (MAP KEY) – tuỳ chọn nhưng nên có
FIRMS_MAP_KEY=
FIRMS_REFRESH_MINUTES=30
# Google Earth Engine (thu ảnh Sentinel-2, ERA5) – đặt tệp khoá service account tại .secrets\gee-key.json
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gee-key.json

# --- MobileGIS ---
# Đăng nhập nhanh theo vai trò: KHÔNG bật trên máy chủ chính thức
MOBILE_DEMO_LOGIN=false
# Web Push / UnifiedPush (Android): để trống thì tự sinh và lưu storage/.vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kiemlam@kontum.gov.vn
# APNs (iOS) – khoá .p8 từ Apple Developer, đặt trong .secrets\
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=vn.gov.kontum.kontumMobilegis
