# MẪU CẤU HÌNH - KHÔNG CHỨA KHÓA THẬT
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rung_kontum
DB_USER=app_kontum
DB_PASSWORD=CHANGE_ME
MAPBOX_TOKEN=SET_RESTRICTED_PUBLIC_TOKEN
MAPBOX_TRAFFIC_TILESET=mapbox.mapbox-traffic-v1
OPENWEATHER_KEY=SET_SERVER_SIDE_KEY
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gee-key.json
FIRMS_MAP_KEY=SET_SERVER_SIDE_KEY
FIRMS_REFRESH_MINUTES=30

# --- MobileGIS: thông báo không Firebase (Socket.IO + PostgreSQL + push theo nền tảng) ---
# Web Push / UnifiedPush (Android, trình duyệt): để trống thì máy chủ tự sinh và lưu storage/.vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kiemlam@kontum.gov.vn
# APNs (iOS): khoá .p8 tạo trong Apple Developer → Keys (đặt trong .secrets/, không commit)
APNS_KEY_FILE=.secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=vn.gov.kontum.kontumMobilegis
# APNS_ENV=production   (mặc định theo môi trường thiết bị đăng ký: sandbox khi build debug)
# MOBILE_DEMO_LOGIN=false  (production: tắt đăng nhập nhanh)
