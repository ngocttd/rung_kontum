# MẪU CẤU HÌNH - KHÔNG CHỨA KHÓA THẬT
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rung_kontum
DB_USER=app_kontum
DB_PASSWORD=CHANGE_ME
MAPBOX_TOKEN=SET_RESTRICTED_PUBLIC_TOKEN
MAPBOX_TRAFFIC_TILESET=mapbox.mapbox-traffic-v1
OPENWEATHER_KEY=SET_SERVER_SIDE_KEY
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gee-key.json
FIRMS_MAP_KEY=SET_SERVER_SIDE_KEY
FIRMS_REFRESH_MINUTES=30

# --- MobileGIS ---
# Đăng nhập nhanh theo vai trò: KHÔNG bật trên máy chủ chính thức
MOBILE_DEMO_LOGIN=false
# Thông báo đẩy Firebase Cloud Messaging (Android + iOS): tệp khoá service account tải ở Firebase console
# → Project settings → Service accounts → Generate new private key; đặt trong .secrets\ (KHÔNG commit). Xem mobile/README.md mục 8.1
FCM_SERVICE_ACCOUNT_FILE=
# FCM_PROJECT_ID=   (tuỳ chọn, mặc định lấy project_id trong tệp khoá)
